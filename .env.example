NODE_ENV=development
HOST=127.0.0.1
PORT=8787
# Use redis for production or multiple replicas. Memory is local-development only.
STORE=memory
REDIS_URL=redis://127.0.0.1:6379
# Required in production: your public HTTPS endpoint origin, without a path.
PUBLIC_ORIGIN=http://localhost:8787
IDLE_TTL_SECONDS=7200
MAX_TTL_SECONDS=86400
# Standalone test page and REST adapter, never enabled in production.
ENABLE_PREVIEW=true
